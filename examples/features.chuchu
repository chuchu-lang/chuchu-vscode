//NOTE: Hover over names or use Go to Definition and Find All References.
function square(x: int) be int {
    return x * x
}

assign count as 3
assign numbers as [1, 2, 3]
show square(count)
show sum(numbers)
show sqrt(9.0)

if count > 0 {
    // The initializer reads the outer count; later uses read this binding.
    assign count as count + 2
    show count
}
show count

assign parsed as parse_int("42")
if is_ok(parsed) {
    show unwrap(parsed)
} else {
    show error_message(parsed)
}

assign message as "Hello, 世界 🌍 // this is a string"
show length(message)

// Records use independent copies and dot access.
record Point {
    x: int
    y: int
}
assign origin as Point {
    x: 0
    y: 0
}
assign moved as origin
reassign moved.x as 3
show moved.x
show origin.x

// Whole-file UTF-8 I/O with recoverable errors.
assign contents as try_read_file("notes.txt")
if is_ok(contents) {
    show unwrap(contents)
} else {
    show error_message(contents)
}

// A variable declared now and given its type by the first reassign.
declare total
reassign total as 40
reassign total as total + 2
show total
